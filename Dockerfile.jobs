FROM --platform=linux/amd64 ghcr.io/catthehacker/ubuntu:act-26.04@sha256:a69bc68d691e9e9afd294dbb9ea7a71e38207c2f0a7b689b5dc6a4cacf06f5e6
USER root
ARG GO_VERSION=1.27.4
ARG GO_SHA256=7226736c2339719cda28fbf3a54d71aa63bcefe376e98cef00034268dab24840
RUN curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" -o /tmp/go.tar.gz \
    && echo "${GO_SHA256}  /tmp/go.tar.gz" | sha256sum -c - \
    && rm -rf /usr/local/go && tar -C /usr/local -xzf /tmp/go.tar.gz \
    && rm /tmp/go.tar.gz
ENV PATH=/usr/local/go/bin:${PATH}
# Chrome comes from Google's apt repository: apt verifies its signature with only the
# key whose primary fingerprint is pinned here. Set CHROME_VERSION to pin a version
# (it builds only while Google's repository still serves that version).
ARG CHROME_KEY_FINGERPRINT=EB4C1BFD4F042F6DDDCCEC917721F63BD38B4796
ARG CHROME_VERSION=
RUN set -eux; \
    export DEBIAN_FRONTEND=noninteractive; \
    list=/etc/apt/sources.list.d/localci-google-chrome.list; \
    keyring=/usr/share/keyrings/localci-google-chrome.gpg; \
    drop_other_chrome_sources() { \
        for source in /etc/apt/sources.list.d/*; do \
            if [ "$source" = "$list" ]; then continue; fi; \
            case "${source##*/}" in google-chrome*) rm -rf "$source"; continue ;; esac; \
            if grep -Eqis 'dl(-ssl)?\.google\.com/linux/chrome' "$source"; then rm -f "$source"; fi; \
        done; \
    }; \
    drop_other_chrome_sources; \
    if ! command -v gpg >/dev/null; then \
        apt-get update; apt-get install -y --no-install-recommends gnupg; \
    fi; \
    export GNUPGHOME="$(mktemp -d)"; \
    curl -fsSL https://dl.google.com/linux/linux_signing_key.pub -o "$GNUPGHOME/google.pub"; \
    gpg --batch --show-keys --with-colons "$GNUPGHOME/google.pub" \
        | awk -F: '$1 == "fpr" && prev == "pub" { print $10 } { prev = $1 }' > "$GNUPGHOME/primary.fpr"; \
    grep -qx "${CHROME_KEY_FINGERPRINT}" "$GNUPGHOME/primary.fpr"; \
    gpg --batch --import "$GNUPGHOME/google.pub"; \
    gpg --batch --export "${CHROME_KEY_FINGERPRINT}" > "$keyring"; \
    test -s "$keyring"; chmod 0644 "$keyring"; \
    gpgconf --kill all 2>/dev/null || true; \
    rm -rf "$GNUPGHOME"; unset GNUPGHOME; \
    echo "deb [arch=amd64 signed-by=$keyring] https://dl.google.com/linux/chrome/deb/ stable main" > "$list"; \
    printf 'repo_add_once="false"\nrepo_reenable_on_distupgrade="false"\n' > /etc/default/google-chrome; \
    chrome=google-chrome-stable; \
    if [ -n "${CHROME_VERSION}" ]; then chrome="google-chrome-stable=${CHROME_VERSION}"; fi; \
    apt-get update; \
    apt-get install -y --no-install-recommends "$chrome" xvfb xauth; \
    rm -rf /var/lib/apt/lists/*; \
    google-chrome --version
# The package's post-install can add its own apt source and trusted key in the
# background. A separate step runs only after every process of the install step has
# ended, removes them, and fails the build unless our source is the only Chrome source
# and our keyring (a name the package does not use) still holds only the pinned key.
RUN set -eu; \
    list=/etc/apt/sources.list.d/localci-google-chrome.list; \
    keyring=/usr/share/keyrings/localci-google-chrome.gpg; \
    pattern='dl(-ssl)?\.google\.com/linux/chrome'; \
    fail() { echo "Chrome apt verification failed: $1" >&2; exit 1; }; \
    for source in /etc/apt/sources.list.d/*; do \
        if [ "$source" = "$list" ]; then continue; fi; \
        case "${source##*/}" in google-chrome*) rm -rf "$source"; continue ;; esac; \
        if grep -Eqis "$pattern" "$source"; then rm -f "$source"; fi; \
    done; \
    rm -rf /etc/apt/trusted.gpg.d/google-chrome* /usr/share/keyrings/google-chrome*; \
    check="$(mktemp -d)"; \
    test -s "$list" || fail "missing $list"; \
    printf 'deb [arch=amd64 signed-by=%s] https://dl.google.com/linux/chrome/deb/ stable main\n' "$keyring" > "$check/expected"; \
    cmp -s "$check/expected" "$list" || fail "unexpected content in $list"; \
    set -- /etc/apt/sources.list.d; \
    if [ -e /etc/apt/sources.list ]; then set -- "$@" /etc/apt/sources.list; fi; \
    status=0; grep -RElis "$pattern" "$@" > "$check/sources" || status=$?; \
    if [ "$status" -gt 1 ]; then fail 'cannot scan apt sources'; fi; \
    grep -qxF "$list" "$check/sources" || fail 'source scan did not find our list'; \
    if grep -vxF "$list" "$check/sources" >&2; then fail 'unexpected Chrome apt source'; fi; \
    if [ -d /etc/apt/trusted.gpg.d ]; then \
        find /etc/apt/trusted.gpg.d -iname '*google-chrome*' > "$check/keys"; \
        if [ -s "$check/keys" ]; then cat "$check/keys" >&2; fail 'unexpected Chrome apt key'; fi; \
    fi; \
    export GNUPGHOME="$check/gnupg"; mkdir -m 0700 "$GNUPGHOME"; \
    test -s "$keyring" || fail "missing $keyring"; \
    gpg --batch --show-keys --with-colons "$keyring" > "$check/keyring"; \
    awk -F: '$1 == "fpr" && prev == "pub" { print $10 } { prev = $1 }' "$check/keyring" > "$check/primary.fpr"; \
    test "$(wc -l < "$check/primary.fpr")" -eq 1 || fail "$keyring must hold exactly one key"; \
    grep -qx "${CHROME_KEY_FINGERPRINT}" "$check/primary.fpr" || fail "$keyring fingerprint changed"; \
    if [ -s /etc/apt/trusted.gpg ]; then \
        gpg --batch --show-keys --with-colons /etc/apt/trusted.gpg > "$check/legacy"; \
        test -s "$check/legacy" || fail 'cannot read /etc/apt/trusted.gpg'; \
        if grep -i '^uid:.*google' "$check/legacy" >&2; then fail 'Google key in /etc/apt/trusted.gpg'; fi; \
    fi; \
    gpgconf --kill all 2>/dev/null || true; \
    rm -rf "$check"
RUN useradd -m -u 1001 -s /bin/bash runner \
    && echo 'runner ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/runner \
    && chmod 440 /etc/sudoers.d/runner
ENV HOME=/home/runner
USER runner:root
RUN go version && test -w "${HOME}"
