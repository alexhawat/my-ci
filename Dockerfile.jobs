FROM --platform=linux/amd64 ghcr.io/catthehacker/ubuntu:act-24.04@sha256:7bf3a8afc2bbfe7fdaf4b9d2716cb2f3634fd21e4f38e26aa17a12cfda80d721
USER root
ARG GO_VERSION=1.27.4
ARG GO_SHA256=7226736c2339719cda28fbf3a54d71aa63bcefe376e98cef00034268dab24840
RUN curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" -o /tmp/go.tar.gz \
    && echo "${GO_SHA256}  /tmp/go.tar.gz" | sha256sum -c - \
    && rm -rf /usr/local/go && tar -C /usr/local -xzf /tmp/go.tar.gz \
    && rm /tmp/go.tar.gz
ENV PATH=/usr/local/go/bin:${PATH}
# Chrome comes from Google's apt repository: apt verifies its signature with only the
# key whose primary fingerprint is pinned here. Set CHROME_VERSION to pin a version.
ARG CHROME_KEY_FINGERPRINT=EB4C1BFD4F042F6DDDCCEC917721F63BD38B4796
ARG CHROME_VERSION=
RUN set -eux; \
    export DEBIAN_FRONTEND=noninteractive; \
    list=/etc/apt/sources.list.d/localci-google-chrome.list; \
    keyring=/usr/share/keyrings/google-chrome.gpg; \
    drop_other_chrome_sources() { \
        for source in /etc/apt/sources.list.d/*; do \
            if [ "$source" != "$list" ] && grep -qs 'dl\.google\.com/linux/chrome' "$source"; then rm -f "$source"; fi; \
        done; \
    }; \
    drop_other_chrome_sources; \
    if ! command -v gpg >/dev/null; then \
        apt-get update; apt-get install -y --no-install-recommends gnupg; \
    fi; \
    export GNUPGHOME="$(mktemp -d)"; \
    curl -fsSL https://dl.google.com/linux/linux_signing_key.pub -o "$GNUPGHOME/google.pub"; \
    gpg --batch --show-keys --with-colons "$GNUPGHOME/google.pub" \
        | awk -F: '$1 == "fpr" && prev == "pub" { print $10 } { prev = $1 }' > "$GNUPGHOME/primary.fpr"; \
    grep -qx "${CHROME_KEY_FINGERPRINT}" "$GNUPGHOME/primary.fpr"; \
    gpg --batch --import "$GNUPGHOME/google.pub"; \
    gpg --batch --export "${CHROME_KEY_FINGERPRINT}" > "$keyring"; \
    test -s "$keyring"; chmod 0644 "$keyring"; \
    gpgconf --kill all 2>/dev/null || true; \
    rm -rf "$GNUPGHOME"; unset GNUPGHOME; \
    echo "deb [arch=amd64 signed-by=$keyring] https://dl.google.com/linux/chrome/deb/ stable main" > "$list"; \
    printf 'repo_add_once="false"\nrepo_reenable_on_distupgrade="false"\n' > /etc/default/google-chrome; \
    chrome=google-chrome-stable; \
    if [ -n "${CHROME_VERSION}" ]; then chrome="google-chrome-stable=${CHROME_VERSION}"; fi; \
    apt-get update; \
    apt-get install -y --no-install-recommends "$chrome" xvfb xauth; \
    drop_other_chrome_sources; \
    rm -f /etc/apt/trusted.gpg.d/google-chrome.gpg; \
    apt-get update; \
    rm -rf /var/lib/apt/lists/*; \
    google-chrome --version
RUN useradd -m -u 1001 -s /bin/bash runner \
    && echo 'runner ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/runner \
    && chmod 440 /etc/sudoers.d/runner
ENV HOME=/home/runner
USER runner:root
RUN go version && test -w "${HOME}"
