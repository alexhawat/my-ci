# Public dashboard origin; use the HTTPS URL supplied by your authenticated ingress.
LOCALCI_URL=https://ci.example.com:9443
# Display label only; do not use a sensitive machine identifier.
LOCALCI_HOST_LABEL="local worker"
# Exact identity inserted by Tailscale Serve and required by the dashboard.
LOCALCI_TAILSCALE_LOGIN=your-login@example.com
# Optional: comma-separated DNS server IPs for containers that CI jobs start with Docker.
# Set this only if those containers must resolve internal names; the default is public DNS.
LOCALCI_NESTED_DNS=
