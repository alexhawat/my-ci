# Public dashboard origin; use the HTTPS URL supplied by your authenticated ingress.
LOCALCI_URL=https://ci.example.com:9443
# Display label only; do not use a sensitive machine identifier.
LOCALCI_HOST_LABEL="local worker"
# Exact identity inserted by Tailscale Serve and required by the dashboard.
LOCALCI_TAILSCALE_LOGIN=your-login@example.com
# Optional: comma-separated DNS server IPs, passed as the nested Docker daemon's --dns, so
# they apply to every container it starts, including all CI job steps. When unset, only
# containers on its default bridge (plain docker run/docker build) fall back to public DNS.
LOCALCI_NESTED_DNS=
# Optional: the nested Docker daemon's --bip and --default-address-pool base. Set both to ranges
# unused on the host's networks if the host daemon sends container DNS to a resolver on its own
# docker0; otherwise image pulls inside CI fail with "server misbehaving". See README.
LOCALCI_NESTED_BIP=
LOCALCI_NESTED_ADDRESS_POOL=
# Optional: CI worker runtime, privileged (default) or sysbox-runc (Sysbox installed on the host).
LOCALCI_WORKER_RUNTIME=
# Optional: dashboard self-update (Execution settings -> my-ci version). The repository whose
# latest commit is shown, the branch fetched from origin, and 0 to turn the button off.
LOCALCI_UPDATE_REPO=
LOCALCI_UPDATE_BRANCH=
LOCALCI_SELF_UPDATE=
